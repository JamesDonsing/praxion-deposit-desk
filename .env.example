# Copy to .env and fill in. Never commit .env.
# Leave PAYPAL_* empty to run in mock mode (no PayPal calls at all).

# PayPal developer sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_ENV=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID shown after adding https://<your-host>/webhooks/paypal to the sandbox app
PAYPAL_WEBHOOK_ID=
# Sandbox business account email (the invoicer)
PAYPAL_INVOICER_EMAIL=
# Sandbox personal account email. In sandbox mode every invoice is addressed here,
# so the fabricated sample customers are never emailed.
SANDBOX_BUYER_EMAIL=

# Optional language model for drafting (any chat-completions-style HTTP endpoint).
# Leave empty to use the deterministic offline drafter.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# App
PUBLIC_BASE_URL=http://127.0.0.1:8000
DATABASE_PATH=data/deposit_desk.db
RATE_LIMIT=on
# Mock mode only: HMAC key for simulated webhooks
MOCK_WEBHOOK_SECRET=
